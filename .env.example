PORT=3000
DATABASE_URL=
REDIS_URL=
# Supabase (server-side only). Apply supabase/migrations before deploying.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# UUID of the sole owner account created in Supabase Auth.
ROUTEFUSION_OWNER_ID=
# Dashboard build-time values. Publishable key is safe to expose; never put the secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Set to https://api.net2coder.in for a separately hosted production dashboard.
VITE_API_URL=
# Required to encrypt provider API keys saved from the dashboard. Use a persistent 32-byte random value.
ENCRYPTION_KEY=
# Local-only default. Replace with a long random secret before deployment.
ADMIN_SECRET=routefusion-local-admin
ROUTEFUSION_API_KEY=rf_live_local_dev_key
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173
REQUESTS_PER_MINUTE=120
# Local development only, if connecting to a provider on a private network.
ALLOW_PRIVATE_PROVIDER_URLS=false
OPENAI_API_KEY=
# Add at least one OpenAI-compatible provider. The key stays in this server-side env file.
PROVIDERS_JSON='[{"id":"openai","name":"OpenAI","baseUrl":"https://api.openai.com/v1","model":"gpt-4o-mini","apiKeyEnv":"OPENAI_API_KEY","priority":10,"enabled":true,"timeoutMs":30000,"capabilities":{"chat":true,"streaming":true,"tools":true,"vision":true,"reasoning":false}}]'
